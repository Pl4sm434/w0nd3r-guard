# Copy this to .env for local testing, or set these as secret
# environment variables in your hosting provider's dashboard.
# Never commit a real .env file.

# --- AI fix suggestions (optional) ---
# Without this, the tool falls back to static per-rule explanations.
ANTHROPIC_API_KEY=

# --- Hosted paid mode ---
# Set to "true" to require a paid access token for every scan and
# switch the UI to zip-upload mode. Leave unset for free local use.
W0ND3R_GUARD_REQUIRE_PAYMENT=false

# Stripe secret key (sk_test_... while testing, sk_live_... in production).
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, from the webhook endpoint you create
# in the Stripe dashboard pointing at POST /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=

# Price IDs from two Stripe Products you create:
#   1. A one-time price (e.g. $5) for a single scan.
#   2. A recurring monthly price (e.g. $15/mo) for unlimited scans.
STRIPE_PRICE_ID_ONE_TIME=
STRIPE_PRICE_ID_SUBSCRIPTION=

# --- Local-only overrides (rarely needed) ---
# W0ND3R_GUARD_PORT=4173
# W0ND3R_GUARD_TOKENS_PATH=
# W0ND3R_GUARD_CACHE_PATH=
